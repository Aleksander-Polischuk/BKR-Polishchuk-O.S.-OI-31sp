  object spBatteryTelemetry: TFDQuery
    Connection = mainModule.cnFBConnect
    SQL.Strings = (
      'SELECT '
      
        '    -- 1. '#1054#1082#1088#1091#1075#1083#1102#1108#1084#1086' '#1095#1072#1089' '#1076#1086' 5 '#1093#1074#1080#1083#1080#1085' ('#1079#1085#1072#1093#1086#1076#1080#1084#1086' '#1085#1072#1081#1073#1083#1080#1078#1095#1080#1081' '#1110#1085#1090#1077#1088 +
        #1074#1072#1083')'
      
        '    DATEADD(MINUTE, (DATEDIFF(MINUTE, CAST('#39'00:00'#39' AS TIME), CAS' +
        'T(LOG_TIMESTAMP AS TIME)) / 5) * 5, '
      
        '            CAST(CAST(LOG_TIMESTAMP AS DATE) AS TIMESTAMP)) AS L' +
        'OG_TIMESTAMP,'
      '    '
      '    BATTERY_ID,'
      
        '    MAX(WORK_STATE) AS WORK_STATE, -- '#1041#1077#1088#1077#1084#1086' '#1086#1089#1090#1072#1085#1085#1110#1081' '#1074#1110#1076#1086#1084#1080#1081' '#1089#1090 +
        #1072#1085' '#1079#1072' '#1094#1110' 5 '#1093#1074#1080#1083#1080#1085
      '    '
      '    -- 2. '#1059#1089#1077#1088#1077#1076#1085#1102#1108#1084#1086' '#1087#1086#1082#1072#1079#1085#1080#1082#1080' '#1090#1077#1083#1077#1084#1077#1090#1088#1110#1111
      '    AVG(SOC_PERCENT) AS SOC_PERCENT,'
      '    AVG(VOLTAGE) AS VOLTAGE,'
      '    AVG(CURRENT_AMPS) AS CURRENT_AMPS,'
      '    AVG(TEMPERATURE) AS TEMPERATURE'
      '    '
      'FROM JRN_BATTERY_TELEMETRY'
      ''
      '-- '#1060#1110#1083#1100#1090#1088#1091#1108#1084#1086' '#1079#1072' '#1086#1073#1088#1072#1085#1080#1084' '#1087#1077#1088#1110#1086#1076#1086#1084', '#1103#1082' '#1110' '#1088#1072#1085#1110#1096#1077
      'WHERE LOG_TIMESTAMP BETWEEN :D_START AND :D_END'
      '  AND BATTERY_ID = 1'
      ''
      '-- 3. '#1043#1088#1091#1087#1091#1108#1084#1086' '#1079#1072' '#1085#1072#1096#1080#1084' '#1074#1080#1088#1072#1093#1091#1074#1072#1085#1080#1084' 5-'#1093#1074#1080#1083#1080#1085#1085#1080#1084' '#1110#1085#1090#1077#1088#1074#1072#1083#1086#1084
      'GROUP BY '
      
        '    1, -- '#1043#1088#1091#1087#1091#1108#1084#1086' '#1087#1086' '#1087#1077#1088#1096#1110#1081' '#1082#1086#1083#1086#1085#1094#1110' ('#1085#1072#1096#1086#1084#1091' 5-'#1093#1074#1080#1083#1080#1085#1085#1086#1084#1091' LOG_TI' +
        'MESTAMP)'
      '    BATTERY_ID'
      ''
      'ORDER BY LOG_TIMESTAMP ASC')
    Left = 483
    Top = 152
    ParamData = <
      item
        Name = 'D_START'
        DataType = ftTimeStamp
        ParamType = ptInput
        Value = '06.06.2025'
      end
      item
        Name = 'D_END'
        DataType = ftTimeStamp
        ParamType = ptInput
        Value = '06.06.2026'
      end>
  end
