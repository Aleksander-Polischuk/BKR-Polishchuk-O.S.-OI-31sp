  object spCurrentTariff: TFDQuery
    Connection = mainModule.cnFBConnect
    SQL.Strings = (
      'SELECT '
      
        '    NAME || '#39' ('#39' || CAST(PRICE_PER_KWH AS DECIMAL(15,2)) || '#39' '#1075#1088 +
        #1085'/'#1082#1042#1090'*'#1075#1086#1076')'#39' AS TARIFF_INFO'
      'FROM REF_ENERGY_TARIFFS'
      'WHERE DEL = FALSE'
      
        '  AND CURRENT_DATE BETWEEN DATE_START AND COALESCE(DATE_END, '#39'20' +
        '99-12-31'#39')'
      '  AND CURRENT_TIME BETWEEN TIME_START AND TIME_END')
    Left = 538
    Top = 65530
  end
  object dsCurrentTariff: TDataSource
    DataSet = spCurrentTariff
    Left = 658
    Top = 65530
  end
  object tUpdateTariff: TTimer
    Interval = 5000
    OnTimer = tUpdateTariffTimer
    Left = 730
    Top = 65533
  end
  object spBatteryStatus: TFDQuery
    Connection = mainModule.cnFBConnect
    SQL.Strings = (
      'SELECT FIRST 1 '
      '    BT.WORK_STATE,'
      '    BT.SOC_PERCENT,'
      '    CAST(BT.SOC_PERCENT AS INTEGER) || '#39'%'#39' AS CHARGE_LEVEL_STR'
      'FROM JRN_BATTERY_TELEMETRY BT'
      'ORDER BY BT.LOG_TIMESTAMP DESC')
    Left = 538
    Top = 50
  end
  object dsBatteryStatus: TDataSource
    DataSet = spBatteryStatus
    Left = 658
    Top = 50
  end
  object spReport_Ready_Details: TFDQuery
    Connection = mainModule.cnFBConnect
    SQL.Strings = (
      
        'SELECT * FROM REPORT_COMPLETED_NESTING_TASKS(:P_DATE_START, :P_D' +
        'ATE_END, :P_STATUS)')
    Left = 618
    Top = 149
    ParamData = <
      item
        Name = 'P_DATE_START'
        DataType = ftDate
        ParamType = ptInput
        Value = 46143d
      end
      item
        Name = 'P_DATE_END'
        DataType = ftDate
        ParamType = ptInput
        Value = 46148d
      end
      item
        Name = 'P_STATUS'
        DataType = ftInteger
        ParamType = ptInput
        Value = -1
      end>
  end
